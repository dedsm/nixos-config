# Shared definitions for the agent-harness module: which plugin is installed
# into which coding-agent harness, and what each plugin consists of. Imported
# by ./default.nix (which writes the files) and by the claude-code module
# (which owns ~/.claude/settings.json and so must splice the hook entries into
# its own managedSettings — see docs/agent-harness.md § Claude Code).
{
  lib,
  pkgs,
  homeManagerConfig,
}:
let
  cfg = homeManagerConfig.agent-harness or { };

  # plugin -> the harnesses it can be installed into. A harness name is the key
  # of that harness's own module in the user config (`claude-code.enable`, ...).
  supported = {
    rtk = [
      "claude-code"
      "antigravity"
    ];
    # Claude Code doesn't need it: its Bash tool inherits the environment of
    # the shell it was started from, which direnv has already loaded for the
    # project. Antigravity's commands don't, hence the export prefix.
    direnv = [ "antigravity" ];
    # rtk's `rtk:posthook` pipeline: compresses tool output after the tool ran
    # (PostToolUse). Upstream applies pipeline hook rules to Claude Code only.
    # It extends rtk's PreToolUse rewrite, so it is inert where `rtk` is off.
    rtk-posthook = [ "claude-code" ];
    # The personal `brain` skill and its SessionStart health line. The store
    # machinery it relies on (the CLI on PATH, the ~/brain bootstrap and
    # commit hooks, the weekly health timer) comes with it in either harness.
    brain = [
      "claude-code"
      "antigravity"
    ];
  };

  # Reject typos and unsupported pairs instead of silently ignoring them: a
  # misspelt `false` would otherwise leave the plugin on.
  checked = lib.mapAttrs (
    plugin: flags:
    if !(supported ? ${plugin}) then
      throw "agent-harness: unknown plugin `${plugin}` (known: ${lib.concatStringsSep ", " (lib.attrNames supported)})"
    else
      lib.mapAttrs (
        harness: value:
        if !(builtins.elem harness supported.${plugin}) then
          throw "agent-harness: `${plugin}` is not supported in `${harness}` (supported: ${
            lib.concatStringsSep ", " supported.${plugin}
          })"
        else if !builtins.isBool value then
          throw "agent-harness: `${plugin}.${harness}` must be a boolean"
        else
          value
      ) flags
  ) cfg;

  # A plugin is active in a harness when that harness's module is enabled and
  # the plugin's flag for it isn't turned off. Flags default to on.
  flagOn =
    plugin: harness:
    (homeManagerConfig.${harness}.enable or false) && ((checked.${plugin} or { }).${harness} or true);
  active = builtins.deepSeq checked (
    lib.mapAttrs (plugin: harnesses: lib.genAttrs harnesses (flagOn plugin)) supported
    // {
      rtk-posthook.claude-code = flagOn "rtk-posthook" "claude-code" && flagOn "rtk" "claude-code";
    }
  );

  # rtk (Rust Token Killer) — token-optimizing CLI proxy. From unstable: it
  # moves faster than stable. Since 1.0 the default binary is BUSL-1.1 (nixpkgs
  # lists it as asl20 + bsl11), so it only evaluates because `unstable` is
  # imported with allowUnfree; upstream's Apache-only `rtk-oss` edition isn't
  # packaged in nixpkgs.
  rtkPkg = pkgs.unstable.rtk;

  brainHealthCommand = "~/.local/bin/claude-brain-health.sh";

  # The awareness text rtk wants each agent to read, generated by the pinned
  # rtk's own `rtk init` against a scratch HOME. It therefore changes exactly
  # when rtk is bumped and can never drift from the binary; if upstream renames
  # a flag or moves a file, `install` fails the build instead of shipping a
  # stale copy. Only the prose is taken from here — the hook entries below are
  # written by hand, since reading rtk's generated JSON back into Nix would be
  # import-from-derivation.
  rtkAgentFiles =
    pkgs.runCommandLocal "rtk-agent-files-${rtkPkg.version}"
      {
        nativeBuildInputs = [ rtkPkg ];
      }
      ''
        export HOME="$TMPDIR" XDG_CONFIG_HOME="$TMPDIR/.config" XDG_DATA_HOME="$TMPDIR/.local/share"
        mkdir -p "$HOME/.claude"
        rtk init -g --auto-patch --no-trust-filters >/dev/null
        rtk init -g --agent antigravity --auto-patch >/dev/null
        install -Dm644 "$HOME/.claude/RTK.md" "$out/claude-code/RTK.md"
        install -Dm644 "$HOME/.gemini/config/plugins/rtk/rules/AGENTS.md" "$out/antigravity/AGENTS.md"
        test -s "$out/claude-code/RTK.md" && test -s "$out/antigravity/AGENTS.md"
      '';

  # rtk's user pipeline file. Picking a built-in by name ties the rules to the
  # pinned rtk (`rtk pipeline show rtk:posthook` prints them), and validating
  # it here fails the build if a bump ever drops or renames that pipeline,
  # rather than leaving rtk to fall back to its default at runtime.
  rtkPipelineFile =
    pkgs.runCommandLocal "rtk-pipeline.toml"
      {
        nativeBuildInputs = [ rtkPkg ];
        text = ''
          # Managed by the agent-harness module (agent-harness.rtk-posthook).
          [pipeline]
          extends = "rtk:posthook"
        '';
        passAsFile = [ "text" ];
      }
      ''
        export HOME="$TMPDIR" XDG_CONFIG_HOME="$TMPDIR/.config" XDG_DATA_HOME="$TMPDIR/.local/share"
        install -Dm644 "$textPath" "$XDG_CONFIG_HOME/rtk/pipeline.toml"
        rtk pipeline validate
        cp "$textPath" "$out"
      '';
in
{
  inherit active;

  rtk = {
    package = rtkPkg;
    agentFiles = rtkAgentFiles;
    pipelineFile = rtkPipelineFile;
  };

  # Consumed by the claude-code module's managedSettings. Empty when rtk is off
  # there, which actively clears a previously merged entry (the merge replaces
  # arrays). The command stays the bare `rtk hook claude` that `rtk init`
  # writes, so `rtk verify`/`rtk gain` keep recognising it as rtk's own hook;
  # ./default.nix puts rtk on PATH whenever this is non-empty.
  claudeCode.preToolUse = lib.optional active.rtk.claude-code {
    matcher = "Bash";
    hooks = [
      {
        type = "command";
        command = "rtk hook claude";
      }
    ];
  };

  # Same contract as preToolUse. The matcher is the tool list `rtk init`
  # registers for `rtk:posthook`; it has to be widened by hand if a later rtk
  # adds rules for more tools (`rtk pipeline validate` then reports
  # "hook needed").
  claudeCode.postToolUse = lib.optional active.rtk-posthook.claude-code {
    matcher = "Bash|Read|Grep|Glob|WebFetch|WebSearch";
    hooks = [
      {
        type = "command";
        command = "rtk hook claude";
      }
    ];
  };

  # The brain plugin's health hook. SessionStart is shared with herdr's own
  # entry, so the claude-code merge array-merges it, dropping any stale copy
  # of this entry by its command path — which therefore stays stable across
  # rebuilds (./default.nix links the script there) and is exported even when
  # the flag is off, so a previously merged entry is still removed.
  claudeCode.brainHealthCommand = brainHealthCommand;
  claudeCode.sessionStart = lib.optional active.brain.claude-code {
    # Deliberately not "compact": the line would repeat mid-task.
    matcher = "startup|resume|clear";
    hooks = [
      {
        type = "command";
        command = brainHealthCommand;
      }
    ];
  };
}
