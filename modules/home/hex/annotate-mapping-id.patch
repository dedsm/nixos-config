+/// Moves the pen to the output the portal says is recorded, once its stream has started,
+/// and back when it ends.
+#[cfg(target_os = "linux")]
+fn place_pen(s: &mut InkState) {
+    let recorded = scrawl_capture::capture::recorded_output();
+    if recorded == s.located {
+        return;
+    }
+    let found = recorded.as_deref().and_then(crate::linux::pen_output::find);
+    tracing::info!(?recorded, ?found, "Annotate pen placed");
+    s.located = recorded;
+    crate::capture_host::set_pen_points(found.as_ref().map(|output| output.points));
+    if let Some(overlay) = &s.overlay {
+        overlay.set_display(match found {
+            Some(output) => rune::DisplayTarget::Native(rune::NativeDisplayId::Wayland(output.global)),
+            None => rune::DisplayTarget::Primary,
+        });
+    }
+}
