+#[test]
+fn deferred_host_appearance_is_released_after_timeout() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+
+    let outcome = state.handle_raw_events(vec![RawInputEvent::HostColorSchemeChanged(
+        crate::terminal_theme::HostAppearance::Light,
+    )]);
+    assert!(outcome.requests.is_empty());
+
+    let mut requests = Vec::new();
+    state.tick_deferred_host_appearance(std::time::Instant::now(), &mut requests);
+    assert!(requests.is_empty());
+
+    state.tick_deferred_host_appearance(
+        std::time::Instant::now() + std::time::Duration::from_secs(1),
+        &mut requests,
+    );
+    assert!(matches!(
+        requests.as_slice(),
+        [ClientMessage::ClientShellHostTheme {
+            update: crate::protocol::ClientHostThemeUpdate::Appearance(
+                crate::protocol::ClientHostAppearance::Light
+            )
+        }]
+    ));
+
+    let mut again = Vec::new();
+    state.tick_deferred_host_appearance(
+        std::time::Instant::now() + std::time::Duration::from_secs(2),
+        &mut again,
+    );
+    assert!(again.is_empty());
+}
